# Open Agent OS - Environment Variables Example
# Do not commit real API keys or secrets to version control.
# Provider API keys can be supplied via environment variables or securely configured via the Settings panel.

# Gemini API
GEMINI_API_KEY=

# OpenRouter API (Primary for MiniMax M2.7 & OpenRouter free router)
OPENROUTER_API_KEY=

# Groq API
GROQ_API_KEY=

# Cerebras Inference API
CEREBRAS_API_KEY=

# Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub Models (Personal Access Token with models access)
GITHUB_TOKEN=

# Hugging Face Inference API
HUGGINGFACE_API_KEY=

# Local Inference (e.g. Ollama or LM Studio)
OLLAMA_BASE_URL=http://localhost:11434

# Server Port
PORT=3000
